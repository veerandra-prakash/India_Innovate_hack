### Example environment variables for building the app
# Replace values before running `npm run build` for production/native builds

# If you want the app to call a production API, set this (e.g. https://api.example.com)
VITE_API_BASE=

# For testing the app on a mobile device/emulator against your local backend,
# set this to your machine's LAN IPv4 address (from `ipconfig`), e.g. 192.168.1.42
# When running from Capacitor (file://), the app will use this to reach the backend.
VITE_LOCAL_IP=
